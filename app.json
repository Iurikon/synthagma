{
  "expo": {
    "name": "Synthagma",
    "slug": "synthagma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/synthagma-icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "synthagma",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.synthagma.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "jsEngine": "jsc",
      "adaptiveIcon": {
        "backgroundColor": "#0D0221",
        "foregroundImage": "./assets/synthagma-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.synthagma.app",
      "allowBackup": true,
      "blockedPermissions": []
    },
    "web": {
      "favicon": "./assets/synthagma-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc9bb3c4-9be5-435f-b9eb-13951fc9b98a"
      }
    },
    "owner": "iurikon"
  }
}
